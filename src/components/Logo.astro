---
// Copyright 2026 OpenSourceOM
// SPDX-License-Identifier: Apache-2.0
interface Props {
  showText?: boolean;
  size?: 'sm' | 'md';
}

const { showText = true, size = 'md' } = Astro.props;
const iconSize = size === 'sm' ? 28 : 32;
---

<span class:list={['logo', size]}>
  <svg
    class="logo-icon"
    width={iconSize}
    height={iconSize}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect width="32" height="32" rx="8" fill="#0D1420" stroke="#1E293B" />
    <circle cx="16" cy="16" r="5" stroke="url(#logoGrad)" stroke-width="2" />
    <circle cx="9" cy="10" r="2" fill="#6366F1" />
    <circle cx="23" cy="10" r="2" fill="#A855F7" />
    <circle cx="23" cy="22" r="2" fill="#22D3EE" />
    <circle cx="9" cy="22" r="2" fill="#F87171" />
    <defs>
      <linearGradient id="logoGrad" x1="8" y1="8" x2="24" y2="24" gradientUnits="userSpaceOnUse">
        <stop stop-color="#22D3EE" />
        <stop offset="1" stop-color="#6366F1" />
      </linearGradient>
    </defs>
  </svg>
  {showText && (
    <span class="logo-text">
      OpenSource<span class="logo-accent">OM</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo-icon {
    flex-shrink: 0;
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.25));
  }

  .logo-text {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .logo.sm .logo-text {
    font-size: 0.95rem;
  }

  .logo.md .logo-text {
    font-size: 1.05rem;
  }

  .logo-accent {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
