---
// Copyright 2026 OpenSourceOM
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from '@/layouts/BaseLayout.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  faq?: FaqItem[];
  related?: RelatedLink[];
}

const { title, description, faq = [], related = [] } = Astro.props;

const sections = [
  {
    label: 'Start',
    links: [
      { href: '/docs/', label: 'Overview' },
      { href: '/docs/getting-started/', label: 'Getting started' },
      { href: '/docs/configuration/', label: 'Configuration' },
    ],
  },
  {
    label: 'Graph',
    links: [
      { href: '/docs/the-graph/', label: 'The graph' },
      { href: '/docs/schema/', label: 'Schema' },
      { href: '/docs/attack-paths/', label: 'Attack paths' },
      { href: '/docs/blast-radius/', label: 'Blast radius' },
      { href: '/docs/prioritization/', label: 'Prioritization' },
    ],
  },
  {
    label: 'Platform',
    links: [
      { href: '/docs/cli/', label: 'CLI' },
      { href: '/docs/api/', label: 'API' },
      { href: '/docs/console/', label: 'Console' },
      { href: '/docs/rules/', label: 'CSPM rules' },
      { href: '/docs/rule-packs/', label: 'Rule packs' },
      { href: '/docs/enrichment/', label: 'CVE enrichment' },
      { href: '/docs/exports/', label: 'Exports' },
    ],
  },
  {
    label: 'Collectors',
    links: [
      { href: '/docs/collectors/', label: 'Overview' },
      { href: '/docs/collectors/aws/', label: 'AWS' },
      { href: '/docs/collectors/azure/', label: 'Azure' },
      { href: '/docs/collectors/gcp/', label: 'GCP' },
      { href: '/docs/collectors/kubernetes/', label: 'Kubernetes' },
      { href: '/docs/collectors/plugins/', label: 'Plugins' },
    ],
  },
  {
    label: 'Operate',
    links: [
      { href: '/docs/architecture/', label: 'Architecture' },
      { href: '/docs/docker/', label: 'Docker Compose' },
      { href: '/docs/kubernetes/', label: 'Kubernetes' },
      { href: '/docs/security/', label: 'Security' },
      { href: '/docs/open-source/', label: 'Open source scope' },
    ],
  },
];

const modified = new Date('2026-09-28T00:00:00.000Z');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

let pageLabel = title;
for (const section of sections) {
  for (const link of section.links) {
    if (link.href === pathname) pageLabel = link.label;
  }
}

const crumbs =
  pathname === '/docs/'
    ? [{ name: 'Documentation', href: new URL('/docs/', Astro.site).href }]
    : [
        { name: 'Documentation', href: new URL('/docs/', Astro.site).href },
        { name: pageLabel, href: canonical },
      ];

const techArticle = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  dateModified: modified.toISOString(),
  author: { '@type': 'Organization', name: 'OpenSourceOM', url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: 'OpenSourceOM', url: Astro.site?.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.href,
  })),
};

const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const jsonLd = faqLd ? [techArticle, breadcrumbLd, faqLd] : [techArticle, breadcrumbLd];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  canonical={canonical}
  jsonLd={jsonLd}
  modifiedTime={modified}
>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <p class="sidebar-label">Documentation</p>
      <nav aria-label="Docs">
        {
          sections.map((section) => (
            <div class="sidebar-section">
              <p class="sidebar-heading">{section.label}</p>
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>
    <article class="docs-content prose container">
      {
        pathname !== '/docs/' && (
          <nav class="docs-breadcrumb" aria-label="Breadcrumb">
            <a href="/docs/">Docs</a>
            <span aria-hidden="true">/</span>
            <span>{pageLabel}</span>
          </nav>
        )
      }
      <slot />
      {
        faq.length > 0 && (
          <section class="docs-faq">
            <h2>Questions</h2>
            {faq.map((item) => (
              <>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </>
            ))}
          </section>
        )
      }
      {
        related.length > 0 && (
          <section>
            <h2>Related reading</h2>
            <ul>
              {related.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <p class="docs-copyright">
        Copyright &copy; 2026 OpenSourceOM. Licensed under{' '}
        <a
          href="https://github.com/OpenSourceOM/website/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer">Apache-2.0</a>.
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    gap: 2rem;
    padding: 3rem 0 4rem;
  }

  .docs-sidebar {
    padding: 0 1rem;
  }

  .sidebar-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .sidebar-section + .sidebar-section {
    margin-top: 1.25rem;
  }

  .sidebar-heading {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
  }

  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .docs-sidebar a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .docs-sidebar a:hover,
  .docs-sidebar a[aria-current='page'] {
    color: var(--accent);
  }

  .docs-content {
    padding: 0 1rem;
    max-width: 74ch;
  }

  .docs-content :global(h1) {
    letter-spacing: -0.02em;
  }

  .docs-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .docs-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .docs-breadcrumb a:hover {
    color: var(--accent);
  }

  .docs-faq h3 {
    margin-bottom: 0.35rem;
  }

  .docs-content :global(.docs-table-wrap) {
    margin: 1.25rem 0 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .docs-content :global(th),
  .docs-content :global(td) {
    padding: 0.7rem 0.9rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  .docs-content :global(th) {
    color: var(--text);
    background: var(--bg-elevated);
    font-weight: 600;
  }

  .docs-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .docs-content :global(td:first-child) {
    color: var(--text);
  }

  .docs-copyright {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .docs-copyright a {
    color: var(--text-muted);
  }

  .docs-copyright a:hover {
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .docs-shell {
      grid-template-columns: 220px minmax(0, 1fr);
      align-items: start;
      width: min(100% - 2rem, 1120px);
      margin-inline: auto;
    }

    .docs-sidebar {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      padding: 0 1rem 0 0;
    }

    .docs-content.container {
      width: auto;
      margin-inline: 0;
      padding: 0 0 0 1.5rem;
    }
  }
</style>

<script>
  const current = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll('.docs-sidebar a').forEach((link) => {
    const href = (link as HTMLAnchorElement).pathname.replace(/\/$/, '') || '/';
    if (href === current) link.setAttribute('aria-current', 'page');
  });
</script>
