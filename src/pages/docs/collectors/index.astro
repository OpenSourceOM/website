<DocsLayout
  title="Cloud security collectors"
  description="Read-only OpenSourceOM collectors for AWS, Azure, GCP, and Kubernetes, plus plugins that write the same security graph."
  faq={[
    {
      question: 'Which clouds can OpenSourceOM scan?',
      answer:
        'Built-in collectors cover AWS, Azure, GCP, and Kubernetes. om scan plugin ingests any other inventory that prints a graph batch to stdout.',
    },
    {
      question: 'Do OpenSourceOM collectors change my cloud account?',
      answer:
        'They call read APIs and upsert the result into Postgres. Give them a read-only role. A later scan updates the same node ids and does not delete resources that disappeared from the account.',
    },
  ]}
