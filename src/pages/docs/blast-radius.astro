<DocsLayout
  title="IAM blast radius"
  description="See which cloud resources an identity can reach by walking CAN_ACCESS and ASSUMES edges in OpenSourceOM."
  faq={[
    {
      question: 'What is IAM blast radius?',
      answer:
        'Blast radius is the set of resources reachable from one identity. OpenSourceOM walks CAN_ACCESS and ASSUMES edges from that identity, up to depth 6.',
    },
    {
      question: 'How do I check blast radius for a role?',
      answer:
