# Optional override for the GA4 measurement ID baked into the site.
# Defaults to G-M9EMDYHBPE when unset.
PUBLIC_GA_MEASUREMENT_ID=
# Resend API key for the contact form (https://resend.com)
# Add the same values in the Vercel project: Settings → Environment Variables
RESEND_API_KEY=
# Optional. Must be a verified domain sender in Resend.
CONTACT_FROM=OpenSourceOM <contact@opensourceom.org>
CONTACT_TO=contact@opensourceom.org
